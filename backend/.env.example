# Configuración General del Entorno
PROJECT_NAME="PetCare API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Seguridad y JWT
SECRET_KEY="petcare-super-secret-jwt-key-change-this-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos (SQLite por defecto para desarrollo local sin dependencias)
# Para PostgreSQL: postgresql://usuario:password@localhost:5432/petcare
DATABASE_URL="sqlite:///./petcare.db"

# Inteligencia Artificial (Opcional - Google Gemini)
# Si se deja en blanco, el backend activa el motor heurístico local de triaje
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS (Orígenes autorizados)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081","http://localhost:19006","http://localhost:8000"]
