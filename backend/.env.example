# Base de Datos
# Para PostgreSQL local: postgresql+psycopg://postgres:postgres@localhost:5432/petcare_db
# Para SQLite (ejecución inmediata local sin instalar postgres): sqlite:///./petcare.db
DATABASE_URL=sqlite:///./petcare.db

# Seguridad JWT
SECRET_KEY=petcare_jwt_super_secret_key_production_grade_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API (google-genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
