        <mxCell id="leg1" value="Notacion: «component» = modulo de software · «database» / «storage» = almacenamiento · «external» = fuera del sistema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
