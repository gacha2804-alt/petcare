        </mxCell>
        <mxCell id="leg2" value="Linea continua = dependencia fuerte (uso requerido). Linea discontinua = dependencia debil / opcional / propuesta." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
