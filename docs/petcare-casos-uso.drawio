        <mxCell id="leg1" value="Línea continua = asociación actor / caso de uso. Línea discontinua con punta abierta = generalización, «include» o «extend». «include» significa que el caso base siempre ejecuta el caso incluido; «extend» significa que lo ejecuta solo bajo una condición." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1510" y="790" width="420" height="90" as="geometry" />
