          <mxGeometry x="20" y="10" width="1780" height="35" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Página 2 de 2 · Ninguno de estos casos tiene un RF asignado: provienen del README, de la matriz de roles y de la entrevista. Se identifican como UC-E01 a UC-E24 (E = extensión propuesta) para no confundirse con los UC-01 a UC-12 y UC-T1 a UC-T6 de la página 1. Deben registrarse como requisitos formales antes de implementar." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="45" width="1780" height="20" as="geometry" />
        </mxCell>

