        </mxCell>

        <mxCell id="g1" value="CUIDADO PREVENTIVO (escritura)" style="swimlane;html=1;startSize=24;rounded=0;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="450" height="250" as="geometry" />
