        </mxCell>
        <mxCell id="n_brecha1" value="BRECHA: RF-06 y RF-07 solo definen la CONSULTA por parte del propietario. El REGISTRO de una vacuna o desparasitación (que hace el veterinario según la matriz del README) no tiene caso de uso propio porque ningún RF lo respalda." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1020" y="520" width="400" height="90" as="geometry" />
        </mxCell>

