        <mxCell id="uce01" value="UC-E01 · Registrar aplicación de vacuna&lt;br&gt;README MVP · sin RF asignado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="125" width="410" height="64" as="geometry" />
